{
  "name": "Phantom DevContainer",
  "dockerFile": "Dockerfile",
  "context": "..",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-azurefunctions",
        "ms-vscode.azurecli",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "postCreateCommand": "python -m venv phantom-env && source phantom-env/bin/activate && pip install -r requirements.txt || true",
  "mounts": [
    "source=${localWorkspaceFolder}/.env,target=/workspace/.env,type=bind,consistency=cached"
  ],
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest"
    }
  }
}
